{
  "name": "dsh-douyin-audio",
  "version": "1.2.0",
  "description": "DSH 插件：刷抖音 + 音频转写 —— 打开抖音网页版下滑浏览推荐视频，把看过的视频下载下来转成文字稿",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "audio",
    "transcribe",
    "duty"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/queyuan072/dsh-douyin-audio.git"
  },
  "homepage": "https://github.com/queyuan072/dsh-douyin-audio#readme",
  "bugs": {
    "url": "https://github.com/queyuan072/dsh-douyin-audio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "README.md",
    "selfcheck.mjs",
    "client.js",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "author": "大肥鱼, 豆老师"
}
