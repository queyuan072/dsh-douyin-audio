# 统一换行符：仓库内一律 LF，避免 Windows(CRLF) 与 Linux/CI(LF) 打架
* text=auto eol=lf

*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.py   text eol=lf

# Windows 专有脚本保持 CRLF（给 cmd/powershell 用）
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制：不要做任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.wav  binary
*.tgz  binary
